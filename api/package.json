{
  "name": "graphrag-api",
  "version": "0.1.0",
  "private": true,
  "description": "API e agente do GraphRAG local (ARQUITETURA §7 e §11)",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.teste.json",
    "start": "node dist/server.js",
    "dev": "node --watch src/server.ts",
    "lint": "eslint .",
    "avaliar:decomposicao": "node src/avaliacao/cli-decomposicao.ts",
    "avaliar:rotas": "node src/avaliacao/cli-rotas.ts",
    "avaliar:paridade": "node src/avaliacao/cli-paridade.ts",
    "avaliar:busca": "node src/avaliacao/cli-busca.ts",
    "avaliar:consultar": "node src/avaliacao/cli-consultar.ts",
    "avaliar:agente": "node src/avaliacao/cli-agente.ts",
    "avaliar:ciclo": "node src/avaliacao/cli-ciclo.ts",
    "avaliar:redator": "node src/avaliacao/cli-redator.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "neo4j-driver": "6.3.0",
    "openai": "7.43.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
